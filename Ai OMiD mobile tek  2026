name: MEXC Account Sync

on:
  workflow_dispatch:
  schedule:
    - cron: "*/30 * * * *"

permissions:
  contents: write

jobs:
  sync:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install dependencies
        run: pip install requests

      - name: Sync MEXC account
        env:
          MEXC_API_KEY: ${{ secrets.MEXC_API_KEY }}
          MEXC_SECRET_KEY: ${{ secrets.MEXC_SECRET_KEY }}
        run: |
          python - <<'PY'
          import os
          import time
          import hmac
          import hashlib
          import requests
          import json

          api_key = os.environ["MEXC_API_KEY"]
          secret = os.environ["MEXC_SECRET_KEY"]

          base = "https://api.mexc.com"
          timestamp = str(int(time.time() * 1000))

          params = f"timestamp={timestamp}"
          signature = hmac.new(
              secret.encode(),
              params.encode(),
              hashlib.sha256
          ).hexdigest()

          url = f"{base}/api/v3/account?{params}&signature={signature}"

          headers = {
              "X-MEXC-APIKEY": api_key
          }

          response = requests.get(url, headers=headers, timeout=30)
          response.raise_for_status()

          data = response.json()

          os.makedirs("data/mexc", exist_ok=True)

          with open("data/mexc/account.json", "w") as f:
              json.dump(data, f, indent=2)

          print("MEXC account synchronization completed.")
          PY

      - name: Commit synchronized data
        run: |
          git config user.name "AI-OMiD MEXC Sync"
          git config user.email "actions@users.noreply.github.com"

          git add data/mexc/account.json

          git diff --cached --quiet || \
            git commit -m "chore: sync MEXC account data"

          git push
